{
  "name": "portfolio-astro",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "version": "0.0.1",
  "description": "Portfolio personal de Horacio Laphitz",
  "author": {
    "name": "Horacio Laphitz",
    "url": "https://horaciolaphitz.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HoracioLaphitz/horaciolaphitz.github.io.git"
  },
  "homepage": "https://horaciolaphitz.vercel.app",
  "bugs": {
    "url": "https://horaciolaphitz.vercel.app"
  },
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:github": "node scripts/sync-github-repos.mjs",
    "prebuild": "pnpm sync:github",
    "build": "astro build --force",
    "build:notebooks": "node --import tsx scripts/build-notebooks.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate:public-surfaces": "node --import tsx scripts/generate-public-surfaces.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy:check": "node scripts/check-deploy.mjs",
    "deploy:verify": "node scripts/verify-deploy-setup.mjs",
    "deploy:push": "powershell -ExecutionPolicy Bypass -File scripts/push-to-github.ps1",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:prod": "cross-env BASE_URL=https://horaciolaphitz.vercel.app node scripts/smoke-test.mjs",
    "security:audit": "pnpm audit --audit-level=high",
    "security:headers": "node scripts/security-headers-test.mjs",
    "security:check": "pnpm security:audit && pnpm security:headers",
    "validate": "pnpm astro check && pnpm test:run && pnpm security:check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "animejs": "4.5.0",
    "astro": "^7.3.1",
    "d3-dsv": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@octokit/rest": "^21.0.2",
    "@types/d3-dsv": "^3.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/ui": "^3.2.6",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "cssnano": "^6.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.0",
    "jsdom": "26.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.22.4",
    "vercel": "^59.10.0",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  }
}
