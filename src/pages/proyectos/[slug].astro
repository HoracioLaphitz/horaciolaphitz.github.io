---
import { getCollection, render } from "astro:content";
import ArticleLayout from "@presentation/layouts/ArticleLayout.astro";
import { ResourceDownload } from "@presentation/components/proyectos/ResourceDownload";
import { ProjectDashboard } from "@presentation/components/dashboards/ProjectDashboard";
import { DASHBOARD_SLUGS } from "@presentation/components/dashboards/dashboard-slugs";
import { ContentImages } from "@presentation/components/proyectos/ContentImages";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos", ({ data }) => !data.draft);
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const hasDashboard = (DASHBOARD_SLUGS as readonly string[]).includes(
  proyecto.id
);
---

<ArticleLayout
  title={proyecto.data.title}
  description={proyecto.data.description}
  category={proyecto.data.category}
  pubDate={proyecto.data.pubDate}
  tags={proyecto.data.tags}
  author={proyecto.data.author}
  github={proyecto.data.github}
  dashboard={proyecto.data.dashboard}
  notebooks={proyecto.data.resources?.notebooks}
  projectSlug={proyecto.id}
  maturity={proyecto.data.maturity}
  currentPath={`/proyectos/${proyecto.id}`}
>
  <div data-content-body class="prose-content">
    <Content />
  </div>

  <ContentImages client:load />

  {hasDashboard && (
    <ProjectDashboard client:only="react" slug={proyecto.id} />
  )}

  <ResourceDownload
    client:load
    notebooks={proyecto.data.resources?.notebooks}
    pdfs={proyecto.data.resources?.pdfs}
    datasets={proyecto.data.resources?.datasets}
  />
</ArticleLayout>
