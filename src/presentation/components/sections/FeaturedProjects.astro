---
import { getCollection } from "astro:content";
import FeaturedProject from "../proyectos/FeaturedProject.astro";

const allProjects = await getCollection("proyectos", ({ data }) => !data.draft && data.featured && data.showcase);

const featuredProjects = allProjects
  .sort((a, b) => {
    const order = [
      "ai-sales-assistant",
      "nb-capitalizacion-bancos-etl",
      "dashboards-ventas-marketing-powerbi",
      "sano-y-fresco-market-basket",
    ];
    return order.indexOf(a.id) - order.indexOf(b.id);
  })
  .slice(0, 4);
---

<section
  id="proyectos"
  aria-labelledby="featured-projects-title"
  class="border-b border-skin-border/40 bg-skin-primary py-12 sm:py-14 lg:py-[clamp(3rem,7vh,5rem)]"
>
  <div class="mx-auto w-full max-w-content px-4 sm:px-6 lg:max-w-container-xl lg:px-8">
    <header class="mb-8 lg:mb-10">
      <h2 id="featured-projects-title" class="text-display-sm font-bold tracking-tight text-skin-text" style={{ letterSpacing: "-0.02em" }}>
        Proyectos
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-skin-text-secondary">
        Casos de trabajo con contexto, contribución, resultado y alcance.
      </p>
    </header>

    {featuredProjects.length === 4 ? (
      <div>
        {featuredProjects.map((project, index) => (
          <FeaturedProject
            project={project}
            showcase={project.data.showcase!}
            index={index}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-xl bg-skin-secondary p-8 text-center">
        <p class="text-skin-muted">
          No hay proyectos destacados disponibles.
        </p>
      </div>
    )}

    <div class="mt-8 text-center lg:mt-10">
      <a
        href="/projects"
        class="focus-ring inline-flex items-center gap-2 px-6 py-3 text-sm font-medium rounded-full bg-brand-primary text-white hover:opacity-90 transition-opacity"
      >
        Ver todos los proyectos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
